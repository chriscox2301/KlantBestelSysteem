@page
@model KE03_INTDEV_SE_1_Base.Pages.OrderhistoryModel
@{
	ViewData["Title"] = "Bestelgeschiedenis";
}

<div class="container py-4">
	<div class="row justify-content-center">
		<div class="col-lg-10">
			<div class="card shadow-sm">
				<div class="card-header bg-primary text-white">
					<h4 class="mb-0">
						<i class="bi bi-clock-history"></i> Bestelgeschiedenis
					</h4>
				</div>
				<div class="card-body">
					@if (Model.CurrentCustomer != null)
					{
						@if (Model.Orders != null && Model.Orders.Any())
						{
							<div class="mb-3">
								<p class="text-muted">
									<i class="bi bi-person"></i> Bestellingen van <strong>@Model.CurrentCustomer.Name</strong>
								</p>
							</div>

							<div class="accordion" id="orderAccordion">
								@for (int i = 0; i < Model.Orders.Count; i++)
								{
									var order = Model.Orders[i];
									var orderId = $"order{i}";
									var headingId = $"heading{i}";
									var collapseId = $"collapse{i}";

									<div class="accordion-item">
										<h2 class="accordion-header" id="@headingId">
											<button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" 
													data-bs-toggle="collapse" data-bs-target="#@collapseId" 
													aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
												<div class="d-flex justify-content-between align-items-center w-100 me-3">
													<div>
														<i class="bi bi-bag-check"></i> 
														<strong>Bestelling van @order.Order.OrderDate.ToString("dd-MM-yyyy")</strong>
													</div>
													<div>
														<small class="text-muted">@order.Order.OrderDate.ToString("HH:mm")</small>
													</div>
												</div>
											</button>
										</h2>
										<div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" 
											 aria-labelledby="@headingId" data-bs-parent="#orderAccordion">
											<div class="accordion-body">
												<div class="table-responsive">
													<table class="table table-hover mb-0">
														<thead class="table-dark">
															<tr>
																<th>Naam</th>
																<th class="text-center">Aantal</th>
																<th class="text-end">Prijs Per Stuk</th>
																<th class="text-end">Totaal</th>
															</tr>
														</thead>
														<tbody>
															@foreach (var product in order.Producten)
															{
																<tr>
																	<td>@product.product.Name</td>
																	<td class="text-center">@product.quantity</td>
																	<td class="text-end">€@product.product.Price.ToString("F2")</td>
																	<td class="text-end fw-bold">€@((product.product.Price * product.quantity).ToString("F2"))</td>
																</tr>
															}
														</tbody>
														<tfoot class="table-light">
															<tr>
																<td colspan="3" class="text-end fw-bold">Totaal:</td>
																<td class="text-end fw-bold text-primary">
																	€@order.Producten.Sum(p => p.product.Price * p.quantity).ToString("F2")
																</td>
															</tr>
														</tfoot>
													</table>
												</div>
											</div>
										</div>
									</div>
								}
							</div>
						}
						else
						{
							<div class="alert alert-info mb-0" role="alert">
								<i class="bi bi-info-circle"></i> U heeft nog geen bestellingen geplaatst.
							</div>
						}
					}
					else
					{
						<div class="alert alert-warning mb-0" role="alert">
							<i class="bi bi-exclamation-triangle"></i> 
							<strong>Log in om uw bestelgeschiedenis te zien!</strong>
							<br>
							<a href="/Account" class="btn btn-primary btn-sm mt-2">
								<i class="bi bi-box-arrow-in-right"></i> Naar inloggen
							</a>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>