@page
@model KE03_INTDEV_SE_1_Base.Pages.CartModel
@{
	ViewData["Title"] = "Winkelwagen";
}

<div class="row justify-content-center">
	<div class="col-lg-8">

		<div class="card shadow-sm">
			<div class="card-header d-flex justify-content-between align-items-center">
				@if (Model.CurrentCustomer == null)
				{
					<span class="text-danger fw-bold">Om een order te plaatsen, log eerst in.</span>
					<a class="btn btn-primary btn-sm" asp-page="/Account">Inloggen</a>
				}
				else
				{
					<span class="fw-bold">Winkelwagen van @Model.CurrentCustomer.Name</span>
					<a class="btn btn-outline-secondary btn-sm" asp-page="/Account">Verander van account</a>
				}
			</div>

			<div class="card-body p-0">
				<h5 class="px-4 pt-3 pb-2 mb-0 border-bottom">Huidige winkelwagen</h5>

				@if (!Model.Items.Any())
				{
					<p class="text-muted text-center py-4">Je winkelwagen is leeg.</p>
				}
				else
				{
					<table class="table table-hover mb-0">
						<thead class="table-light">
							<tr>
								<th>Naam</th>
								<th class="text-center">Aantal</th>
								<th class="text-end">Prijs per stuk</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model.Items)
							{
								<tr>
									<td class="align-middle">@item.product.Name</td>
									<td class="text-center align-middle">@item.quantity</td>
									<td class="text-end align-middle">€@item.product.Price</td>
									<td class="text-end align-middle">
										<form method="post" asp-page-handler="DeleteCartItem">
											<input type="hidden" name="id" value="@item.product.Id" />
											<button class="btn btn-outline-danger btn-sm" type="submit">
												<i class="bi bi-trash"></i>
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>

			<div class="card-footer d-flex justify-content-between align-items-center">
				<span class="fw-bold fs-5">Totaal: <span class="text-success">€@Model.Total.ToString()</span></span>
				@if (Model.CurrentCustomer != null && Model.Items.Any())
				{
					<form method="post" asp-page-handler="OrderCart">
						<button class="btn btn-success" type="submit">Order plaatsen</button>
					</form>
				}
			</div>
		</div>

	</div>
</div>
