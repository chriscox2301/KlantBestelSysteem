@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<link rel='stylesheet' type='text/css' media='screen' href='~/css/index.css'>

<div class="text-center">
    <img src="~/img/aanbieding.png" class="img-fluid mx-auto d-block"/>
</div>

<div class="container">
    <h1>Meest verkochte producten</h1>
    <div class="row">
        @foreach (var p in Model.BestSellingProducts)
        {
            <div class="col-md-4">
                <a asp-page="/Product" asp-route-id="@p.Id" class="product-link">
                    <div class="card">
                        <img src="@p.ImageUrl" class="card-img-top img-fluid"
                             style="height: 200px; object-fit: contain;" />
                        <div class="card-body">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="card-text">€@p.Price.ToString()</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

