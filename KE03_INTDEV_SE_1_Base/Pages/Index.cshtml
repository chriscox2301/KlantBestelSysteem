@page
@model IndexModel
@{
	ViewData["Title"] = "Home";
}

<div class="hero-section mb-4">
	<img src="~/img/aanbieding.png" class="img-fluid w-100" alt="Aanbieding">
</div>

<div class="container py-4">
	<div class="row mb-4">
		<div class="col-12">
			<h2 class="fw-bold mb-1">Meest verkochte producten</h2>
			<p class="text-muted">Bekijk onze populairste items</p>
		</div>
	</div>

	@if (Model.BestSellingProducts != null && Model.BestSellingProducts.Any())
	{
		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
			@foreach (var p in Model.BestSellingProducts)
			{
				<div class="col">
					<a asp-page="/Product" asp-route-id="@p.Id" class="text-decoration-none">
						<div class="card h-100 shadow-sm product-card">
							<img src="@p.ImageUrl" class="card-img-top" alt="@p.Name"
								 style="height: 250px; object-fit: cover" />
							<div class="card-body d-flex flex-column">
								<h5 class="card-title text-dark">@p.Name</h5>
								<div class="mt-auto">
									<p class="h5 text-black fw-bold mb-2">€@p.Price.ToString("F2")</p>
									<span class="btn btn-primary btn-sm w-100">Bekijk product</span>
								</div>
							</div>
						</div>
					</a>
				</div>
			}
		</div>
	}
	else
	{
		<div class="alert alert-info">Er zijn momenteel geen producten beschikbaar.</div>
	}
</div>

<style>
	.product-card {
		transition: all 0.3s ease;
	}

	.product-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.2) !important;
	}
</style>