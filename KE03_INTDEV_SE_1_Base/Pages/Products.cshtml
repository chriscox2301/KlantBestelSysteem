@page
@model KE03_INTDEV_SE_1_Base.Pages.ProductsModel
@{
    ViewData["Title"] = "Producten";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 class="fw-bold">Alle Producten</h2>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <p class="text-muted">Zoekresultaten voor: <strong>@Model.SearchQuery</strong></p>
            }
        </div>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="text-center py-5">
                    <img src="~/img/Icons/BadSearch.png" alt="Geen resultaten" class="img-fluid mb-4" style="max-height: 200px;">
                    <h3 class="text-danger">Geen resultaten gevonden</h3>
                    <p class="text-muted">Uw zoekresultaat leverde geen resultaten op</p>
                    <a asp-page="/Products" asp-route-search="" class="btn btn-primary mt-3">
                        <i class="bi bi-arrow-left"></i> Terug naar alle producten
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var product in Model.Products)
            {
                <div class="col-12">
                    <a asp-page="/Product" asp-route-id="@product.Id" class="text-decoration-none">
                        <div class="card shadow-sm product-item">
                            <div class="row g-0">
                                <div class="col-md-3">
                                    <img src="@product.ImageUrl" class="img-fluid rounded-start h-100" alt="@product.Name" 
                                         style="object-fit: contain; padding: 15px; background-color: #f8f9fa;">
                                </div>
                                <div class="col-md-9">
                                    <div class="card-body d-flex flex-column h-100">
                                        <div class="flex-grow-1">
                                            <h5 class="card-title text-dark fw-bold">@product.Name</h5>
                                            <p class="card-text text-muted">@product.Description</p>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mt-2">
                                            <h4 class="text-primary fw-bold mb-0">€@product.Price.ToString("F2")</h4>
                                            <span class="btn btn-success">
                                                Voeg toe aan winkelwagen <i class="bi bi-arrow-right"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .product-item {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,.125);
    }

    .product-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        border-color: #0d6efd;
    }
</style>