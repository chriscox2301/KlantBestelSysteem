@page
@model KE03_INTDEV_SE_1_Base.Pages.ProductsModel
@{
    ViewData["Title"] = "Producten";
}

<h1>Alle Producten</h1>

<div class="container mt-4">
    @if (!Model.Products.Any())
    {
        <div class="badSearch">
            <img class="badSearchImg" src="~/img/Icons/BadSearch.png" />
            <h1>Uw zoekresultaat leverde geen resultaten op</h1>
        </div>
    }
    @foreach (var product in Model.Products)
    {
        <a asp-page="/Product" asp-route-id="@product.Id" class="product-link">
            <div class="product-card">
                <img src="@product.ImageUrl" class="product-img" />
                <div class="product-info">
                    <h4>@product.Name</h4>
                    <div class="text-muted">@product.Description</div>
                    <div class="price">€@product.Price.ToString()</div>
                </div>
            </div>
        </a>
    }
</div>